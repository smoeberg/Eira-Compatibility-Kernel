# Hetzner — portal (eck) + data (api, fp)

# Portal: admin SPA + NestJS BFF
eck.eira-systems.eu {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	handle /api/* {
		reverse_proxy bff:3001
	}
	handle /auth/* {
		reverse_proxy bff:3001
	}
	handle /health {
		reverse_proxy bff:3001
	}
	handle /ready {
		reverse_proxy bff:3001
	}
	handle /metrics {
		reverse_proxy bff:3001
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# Data API — not for browser; restrict at firewall to BFF + ops
# See infra/firewall/README.md
api.eck.eira-systems.eu {
	reverse_proxy api:3000
}

# Fingerprint passthrough — public (fagsystem traffic)
*.fp.eira-systems.eu {
	reverse_proxy api:3000
}

DATABASE_URL=postgresql://eck:eck@localhost:5433/eck
PORT=3000

# Admin SPA → /api/v1/*
ADMIN_API_KEY=change-me-admin

# Envoy / internal ingest
INTERNAL_API_KEY=change-me-internal

# v2 BFF → API (Simply proxy) — preferred over ADMIN_API_KEY in prod
# ECK_SERVICE_TOKEN=
# ECK_SERVICE_TOKEN_PREVIOUS=   # overlap during rotation

# HMAC for signed user headers (preferred separate from service token)
# ECK_BFF_SIGNING_SECRET=
# ECK_BFF_SIGNING_SECRET_PREVIOUS=
# ECK_BFF_SIGNATURE_MAX_SKEW_SECONDS=300
# ECK_REQUIRE_BFF_SIGNATURE=true   # always verify HMAC on service-token calls

# Require X-ECK-Service-Id on service-token calls (default: required)
# ECK_REQUIRE_SERVICE_ID=false   # dev only

# Prod: admin API only reachable via BFF — blocks direct browser + ADMIN_API_KEY
# ECK_API_BFF_ONLY=true

# Require X-User-Sub from BFF when OIDC enabled (prod)
# ECK_REQUIRE_USER_CONTEXT=true

# Public URLs
ECK_FP_DOMAIN=fp.localhost
ECK_PUBLIC_DOMAIN=localhost
ECK_PUBLIC_PROTOCOL=http
ECK_ADMIN_HOST=eck.localhost

# Production example:
# ECK_FP_DOMAIN=fp.eira-systems.eu
# ECK_PUBLIC_PROTOCOL=https
# ECK_ADMIN_HOST=eck.eira-systems.eu

# Auto-complete fingerprint runs after ends_at (default: on, every 5 min)
# FINGERPRINT_AUTO_COMPLETE=false
# FINGERPRINT_AUTO_COMPLETE_INTERVAL_MS=300000

# --- NestJS BFF (apps/bff) — portal gateway on Hetzner ---
# PORT=3001
# ECK_UPSTREAM_API_URL=http://localhost:3000
# ECK_BFF_SESSION_SECRET=
# ECK_OIDC_ENABLED=false
# ECK_OIDC_TENANT_ID=
# ECK_OIDC_CLIENT_ID=
# ECK_OIDC_CLIENT_SECRET=
# ECK_OIDC_REDIRECT_URI=http://eck.localhost/auth/callback
# ECK_OIDC_POST_LOGOUT_REDIRECT=http://eck.localhost/
